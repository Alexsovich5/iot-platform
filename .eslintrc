{
  "env": {
    "node": true,
    "mocha": true
  },
  "plugins": ["react"],
  "ecmaFeatures": {
    "jsx": true
  },
  "rules": {
    "strict": [2, "global"],
    "no-unused-vars": 2,
    "no-undef": 2,
    "quotes": [2, "single"],
    "semi": [2, "always"],
    "react/jsx-uses-react": 2,
    "react/jsx-uses-vars": 2
  }
}
